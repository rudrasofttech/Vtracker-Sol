@using VisitTracker.Models;
@using VisitTracker.DataContext;
@using VisitTracker.Web.Services
@inject VisitTracker.DataContext.VisitTrackerDBContext context;
@inject HomePageStatsService HomePageStatsService

@Count.ToString("#,##0")

@code {
    public int Count { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Count = HomePageStatsService.GetSnapshot().WebsiteCount;
    }
}

@page
@using System.Globalization
@using VisitTracker.Web.Helpers
@using VisitTracker.Web.Pages
@model ReportModel
@{
    ViewData["Title"] = Model.WebsiteName + " report";
    var c = Model.Current;
    var p = Model.Previous;
}
@functions {
    static string Inv(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    static (string Text, string Css) Delta(double cur, double prev, bool lowerIsBetter = false, bool points = false)
    {
        if (prev == 0 && cur == 0) return ("no change", "text-muted");
        if (!points && prev == 0) return ("new", "text-muted");

        var diff = points ? cur - prev : (cur - prev) / prev * 100;
        if (Math.Abs(diff) < 0.5) return ("no change", "text-muted");

        var arrow = diff > 0 ? "▲" : "▼";
        var text = points ? $"{arrow} {Math.Abs(diff):0.#} pts" : $"{arrow} {Math.Abs(diff):0}%";
        var good = lowerIsBetter ? diff < 0 : diff > 0;
        return (text, good ? "delta-good" : "delta-bad");
    }

    void Kpi(string label, string value, (string Text, string Css) delta, string? hint = null)
    {
        <div class="kpi" title="@hint">
            <div class="kpi-label">@label</div>
            <div class="kpi-value">@value</div>
            <div class="kpi-delta @delta.Css">@delta.Text</div>
        </div>
    }

    void Bars(IReadOnlyList<ReportShareRow> rows, string emptyText)
    {
        if (rows.Count == 0)
        {
            <p class="text-muted small mb-0">@emptyText</p>
            return;
        }

        var max = Math.Max(1, rows.Max(r => r.Count));
        <div class="bars">
            @foreach (var r in rows)
            {
                <div class="bar-row">
                    <div class="bar-label" title="@r.Name">@r.Name</div>
                    <div class="bar-track"><div class="bar-fill" style="width:@Inv(r.Count * 100.0 / max)%"></div></div>
                    <div class="bar-count">@r.Count.ToString("N0") <span class="text-muted">@r.Pct.ToString("0")%</span></div>
                </div>
            }
        </div>
    }
}
@section Head {
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.1.3/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/css/report.css")" />
}

<div class="report">
    <div class="report-header py-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h1>@Model.WebsiteName</h1>
                <div class="text-muted">@Model.RangeDescription · <a href="@Model.RangeUrl("/Visits")">Visits</a></div>
            </div>
            @await Html.PartialAsync("_RangePicker", Model.Picker())
        </div>
    </div>

    @{
        var visitorsHint = "Unique visitors in this range. Counted per visit for data before 13 Nov 2026, so older ranges overcount.";
        var timeHint = "Average time between a visit's first page load and its last activity, capped at 30 minutes per visit.";
        var bounceHint = "Visits that saw one page and left within 10 seconds.";
    }
    <section class="kpis mb-1">
        @{ Kpi("Visitors", c.Visitors.ToString("N0"), Delta(c.Visitors, p.Visitors), visitorsHint); }
        @{ Kpi("Visits", c.Visits.ToString("N0"), Delta(c.Visits, p.Visits)); }
        @{ Kpi("Page views", c.PageViews.ToString("N0"), Delta(c.PageViews, p.PageViews)); }
        @{ Kpi("Pages per visit", c.PagesPerVisit.ToString("0.0"), Delta(c.PagesPerVisit, p.PagesPerVisit)); }
        @{ Kpi("Avg. time on site", VisitAnalytics.Duration(c.AvgSeconds), Delta(c.AvgSeconds, p.AvgSeconds), timeHint); }
        @{ Kpi("Bounce rate", c.BouncePct.ToString("0") + "%", Delta(c.BouncePct, p.BouncePct, lowerIsBetter: true, points: true), bounceHint); }
        @{ Kpi("Returning visitors", c.ReturningPct.ToString("0") + "%", Delta(c.ReturningPct, p.ReturningPct, points: true)); }
    </section>
    <p class="small text-muted mb-4">
        Changes compare with @Model.PreviousDescription.
        @if (!Model.IncludeBots && Model.HiddenBotVisits > 0)
        {
            <span>@Model.HiddenBotVisits.ToString("N0") bot visits are hidden.</span>
        }
    </p>

    @if (!Model.HasData)
    {
        <div class="panel text-center py-5">
            <h2>No visits in this range</h2>
            <p class="text-muted mb-0">Choose a longer range, or check that the tracking script is installed on @Model.WebsiteName.</p>
        </div>
    }
    else
    {
        <section class="panel mb-4">
            <h2>Visits over time</h2>
            <div id="chartVisits" class="ct-chart" style="height:260px;"></div>
            <div class="legend mt-2">
                <span class="l-visits">Visits</span>
                <span class="l-returning">Returning visits</span>
                <span class="l-previous">Previous period</span>
            </div>
        </section>

        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <section class="panel">
                    <h2>Traffic sources</h2>
                    <p class="panel-note">Paid search is detected from Google Ads click IDs in the landing page address. Social includes visits from Instagram and Facebook's built-in browsers.</p>
                    @{ Bars(Model.Channels, "No visits in this range."); }

                    @if (Model.Campaigns.Count > 0)
                    {
                        <h3 class="mt-4">Campaigns</h3>
                        Bars(Model.Campaigns, "");
                    }
                </section>
            </div>
            <div class="col-lg-6">
                <section class="panel">
                    <h2>Referrers</h2>
                    <p class="panel-note">The site a visitor came from. Expand a row to see the exact addresses.</p>
                    <table class="table table-sm" id="refTable">
                        <thead>
                            <tr><th>Source</th><th class="num">Visits</th><th class="num">Share</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Referrers)
                            {
                                <tr>
                                    <td>
                                        @if (r.Hosts.Count > 0)
                                        {
                                            <details>
                                                <summary>@r.Group</summary>
                                                <ul class="mb-0 small">
                                                    @foreach (var host in r.Hosts)
                                                    {
                                                        <li>@host</li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                        else
                                        {
                                            @r.Group
                                        }
                                    </td>
                                    <td class="num">@r.Count.ToString("N0")</td>
                                    <td class="num" data-order="@Inv(r.Pct)">@r.Pct.ToString("0")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            </div>
        </div>

        <section class="panel mb-4">
            <h2>Pages</h2>
            <p class="panel-note">
                Ad and tracking parameters (gclid, gad_source, utm_…) are removed, so each page appears once.
                <strong>Entries</strong> counts visits that started on the page; <strong>exit rate</strong> is the share of views after which the visitor left.
                Open a page's view count to see its click map, scroll reach and where visitors went next.
                @if (Model.ScrollCoveragePct < 90)
                {
                    <span>Scroll depth is only recorded for newer visits (@Model.ScrollCoveragePct.ToString("0")% of page views in this range).</span>
                }
            </p>
            <table class="table table-sm" id="pagesTable">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th class="num">Views</th>
                        <th class="num">Visitors</th>
                        <th class="num">Entries</th>
                        <th class="num">Avg. time</th>
                        <th class="num">Avg. scroll</th>
                        <th class="num">Exit rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pg in Model.Pages)
                    {
                        <tr>
                            <td class="page-cell" title="@pg.Page">
                                <a href="@pg.Url" target="_blank" rel="noopener">@pg.Page</a>
                            </td>
                            <td class="num"><a href="@Model.RangeUrl("/PageReport", ("path", pg.Url))">@pg.Views.ToString("N0")</a></td>
                            <td class="num">@pg.Visitors.ToString("N0")</td>
                            <td class="num">@pg.Entries.ToString("N0")</td>
                            <td class="num" data-order="@Inv(pg.AvgSeconds)">@VisitAnalytics.Duration(pg.AvgSeconds)</td>
                            <td class="num" data-order="@Inv(pg.AvgScroll ?? -1)">@(pg.AvgScroll.HasValue ? pg.AvgScroll.Value.ToString("0") + "%" : "–")</td>
                            <td class="num" data-order="@Inv(pg.ExitPct)">@pg.ExitPct.ToString("0")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="panel mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
                <h2>Recent visits</h2>
                <a href="@Model.RangeUrl("/Visits")">See all visits and filters</a>
            </div>
            <p class="panel-note">The 10 latest visits in this range. Open one to see every page and action in order.</p>
            <div class="table-responsive">
                <table class="table table-sm table-report mb-0">
                    <thead>
                        <tr>
                            <th>Started</th><th>Source</th><th>Landing page</th>
                            <th class="num">Pages</th><th class="num">Length</th><th>Device</th><th>Location</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.RecentVisits)
                        {
                            <tr>
                                <td class="text-nowrap"><a href="@Model.RangeUrl("/Visits", ("open", v.Ref))">@v.LocalStart.ToString("d MMM, h:mm tt")</a></td>
                                <td class="text-nowrap" title="@v.Source">@v.Channel</td>
                                <td class="page-cell" title="@v.Landing">@v.Landing</td>
                                <td class="num">@v.Pages</td>
                                <td class="num">@VisitAnalytics.Duration(v.Seconds)</td>
                                <td class="text-nowrap">@v.Device · @v.OperatingSystem</td>
                                <td class="text-nowrap">@v.Location</td>
                                <td>@await Html.PartialAsync("_VisitBadges", v)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <section class="panel">
                    <h2>Most clicked links</h2>
                    <p class="panel-note">Links and buttons visitors tapped, including WhatsApp, phone and outbound links.</p>
                    @if (Model.Clicks.Count == 0)
                    {
                        <p class="text-muted small mb-0">No link clicks recorded in this range.</p>
                    }
                    else
                    {
                        <table class="table table-sm" id="clicksTable">
                            <thead>
                                <tr><th>Type</th><th>Link</th><th>Text</th><th class="num">Clicks</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var ck in Model.Clicks)
                                {
                                    <tr>
                                        <td><span class="kind">@ck.Kind</span></td>
                                        <td class="page-cell" title="@ck.Target">@ck.Target</td>
                                        <td class="page-cell" title="@ck.Text">@ck.Text</td>
                                        <td class="num">@ck.Clicks.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
            </div>
            <div class="col-lg-5">
                <section class="panel">
                    <h2>Devices</h2>
                    @if (Model.UserAgentCoveragePct < 90)
                    {
                        <p class="panel-note">Operating system and in-app browsers are only known for visits recorded since the tracker update (@Model.UserAgentCoveragePct.ToString("0")% of visits in this range). Older visits show as "Not recorded".</p>
                    }
                    <h3>Device type</h3>
                    @{ Bars(Model.Devices, "No device data."); }
                    <h3>Operating system</h3>
                    @{ Bars(Model.OperatingSystems, "No data."); }
                    <h3>Browser</h3>
                    @{ Bars(Model.Browsers, "No data."); }
                </section>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <section class="panel">
                    <h2>States and regions</h2>
                    @{ Bars(Model.Regions, "No location data."); }
                </section>
            </div>
            <div class="col-lg-4">
                <section class="panel">
                    <h2>Cities</h2>
                    @{ Bars(Model.Cities, "No location data."); }
                </section>
            </div>
            <div class="col-lg-4">
                <section class="panel">
                    <h2>Countries</h2>
                    @{ Bars(Model.Countries, "No location data."); }
                </section>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <section class="panel">
                    <h2>When people visit</h2>
                    <p class="panel-note">Visits by day and hour, in the website's time zone. Darker means more visits; hover a cell for the count.</p>
                    <div class="heatmap">
                        <table>
                            <thead>
                                <tr>
                                    <th></th>
                                    @for (var h = 0; h < 24; h++)
                                    {
                                        <th>@(h % 3 == 0 ? new DateTime(2000, 1, 1, h, 0, 0).ToString("htt").ToLowerInvariant() : "")</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (var d = 0; d < 7; d++)
                                {
                                    <tr>
                                        <th>@ReportModel.WeekdayLabels[d]</th>
                                        @for (var h = 0; h < 24; h++)
                                        {
                                            var count = Model.Heatmap[d][h];
                                            var alpha = Model.HeatmapMax == 0 ? 0 : 0.06 + 0.94 * count / Model.HeatmapMax;
                                            <td class="cell" style="background:rgba(231,76,60,@Inv(count == 0 ? 0.04 : alpha))"
                                                title="@(ReportModel.WeekdayLabels[d] + " " + new DateTime(2000, 1, 1, h, 0, 0).ToString("h tt") + ": " + count + " visits")">@count</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
            <div class="col-lg-4">
                <section class="panel">
                    <h2>Data quality</h2>
                    <dl class="row mb-0 small">
                        <dt class="col-8 fw-normal">Bot visits @(Model.IncludeBots ? "included" : "hidden")</dt>
                        <dd class="col-4 text-end">@(Model.IncludeBots ? "–" : Model.HiddenBotVisits.ToString("N0"))</dd>
                        <dt class="col-8 fw-normal">Visits through a VPN or proxy (shown)</dt>
                        <dd class="col-4 text-end">@Model.ProxyVisits.ToString("N0")</dd>
                        <dt class="col-8 fw-normal">Visits with device details</dt>
                        <dd class="col-4 text-end">@Model.UserAgentCoveragePct.ToString("0")%</dd>
                        <dt class="col-8 fw-normal">Page views with scroll depth</dt>
                        <dd class="col-4 text-end">@Model.ScrollCoveragePct.ToString("0")%</dd>
                    </dl>
                </section>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="//cdn.datatables.net/2.1.3/js/dataTables.min.js"></script>
    <script src="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.js"></script>
    <script>
        (function () {
            var opts = { paging: true, pageLength: 10, lengthChange: false, info: false };
            if (document.getElementById('pagesTable')) new DataTable('#pagesTable', Object.assign({}, opts, { order: [[1, 'desc']], pageLength: 15 }));
            if (document.getElementById('refTable')) new DataTable('#refTable', Object.assign({}, opts, { order: [[1, 'desc']], searching: false }));
            if (document.getElementById('clicksTable')) new DataTable('#clicksTable', Object.assign({}, opts, { order: [[3, 'desc']] }));
        })();

        (function () {
            var el = document.getElementById('chartVisits');
            if (!el) return;

            var labels = @Json.Serialize(Model.Series.Select(s => s.Label));
            var data = {
                labels: labels,
                series: [
                    { className: 'series-previous', data: @Json.Serialize(Model.Series.Select(s => s.Previous)) },
                    { className: 'series-returning', data: @Json.Serialize(Model.Series.Select(s => s.Returning)) },
                    { className: 'series-visits', data: @Json.Serialize(Model.Series.Select(s => s.Visits)) }
                ]
            };

            // Show at most ~14 x-axis labels so long ranges stay readable.
            var step = Math.max(1, Math.ceil(labels.length / 14));

            new Chartist.Line(el, data, {
                height: '260px',
                lineSmooth: Chartist.Interpolation.monotoneCubic(),
                fullWidth: true,
                chartPadding: { right: 24 },
                axisX: {
                    showGrid: false,
                    labelInterpolationFnc: function (value, index) { return index % step === 0 ? value : null; }
                },
                axisY: { onlyInteger: true, low: 0 }
            });
        })();
    </script>
}

@page
@using System.Text
@using VisitTracker.Models
@model VisitTracker.Web.Pages.PageReportModel

@{
    string xvaluevisit = "", yvaluevisit = "", yreturnvaluevisit = "", ynewvaluevisit = "", browserlabel = "", browserpoint = "";
    StringBuilder builder = new StringBuilder();
    StringBuilder buildery = new StringBuilder();

    foreach (var point in Model.DisplayInfo.VisitsData)
    {
        builder.Append("'").Append(point.X).Append("',");
        buildery.Append(point.Y).Append(",");
    }

    xvaluevisit = builder.ToString().TrimEnd(',');
    yvaluevisit = buildery.ToString().TrimEnd(',');
    builder.Clear();
    buildery.Clear();

    foreach (var point in Model.DisplayInfo.ReturnVisitsData)
    {
        buildery.Append(point.Y).Append(",");
    }
    yreturnvaluevisit = buildery.ToString().TrimEnd(',');
    buildery.Clear();

    foreach (var point in Model.DisplayInfo.NewVisitsData)
    {
        buildery.Append(point.Y).Append(",");
    }
    ynewvaluevisit = buildery.ToString().TrimEnd(',');
    buildery.Clear();

    foreach (var point in Model.DisplayInfo.BrowserData)
    {
        builder.Append("'").Append(point.Label).Append("',");
        buildery.Append(point.Percentage).Append(",");
    }

    browserlabel = builder.ToString().TrimEnd(',');
    browserpoint = buildery.ToString().TrimEnd(',');
}
@section Head {
    <link rel="stylesheet" href="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.css" />
    <style>
        .ct-series.series-all .ct-line, .ct-series.series-all .ct-point { stroke: #e74c3c !important; }
        .ct-series.series-new .ct-line, .ct-series.series-new .ct-point { stroke: #ff7f7f !important; }
        .ct-series.series-return .ct-line, .ct-series.series-return .ct-point { stroke: #f1c40f !important; }
        .legend-all { color: #e74c3c; font-weight: 600; }
        .legend-new { color: #ff7f7f; font-weight: 600; }
        .legend-return { color: #f1c40f; font-weight: 600; }
    </style>
}

<div class="container-fluid">
    <h1 class="fs-3">@Model.DisplayInfo.Path</h1>
    <p class="mb-2">@Model.DisplayInfo.VisitChartDescription</p>

    <form method="get" class="row row-cols-lg-auto g-2 align-items-center mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="path" value="@Model.Path" />
        <div class="col-12">
            <input name="start" type="date" class="form-control" value="@Model.DisplayInfo.Start.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12">
            <input name="end" type="date" class="form-control" value="@Model.DisplayInfo.End.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-12">
            <label class="form-check-label">
                <input class="form-check-input" type="checkbox" name="bots" value="1" @(Model.IncludeBots ? "checked" : "") />
                Include bots
            </label>
        </div>
        <div class="col-12">
            <button class="btn btn-primary" type="submit">Change</button>
        </div>
    </form>

    @if (!Model.IncludeBots && Model.HiddenBotVisits > 0)
    {
        <div class="text-muted mb-2">@Model.HiddenBotVisits bot visits hidden</div>
    }

    <div class="my-4">
        <div id="chartVisit" class="ct-chart ct-perfect-fourth" style="max-height:250px;"></div>
        <div>
            <span class="legend-all me-2">All</span>
            <span class="legend-return me-2">Return</span>
            <span class="legend-new me-2">New</span>
        </div>
    </div>

    <div class="p-2">
        <h4 class="title">Browsers</h4>
        <div id="chartPreferences" class="ct-chart ct-perfect-fourth" style="max-height:250px;"></div>
    </div>
</div>

@section Scripts {
    <script src="//cdn.jsdelivr.net/chartist.js/latest/chartist.min.js"></script>
    <script>
        var dataVisits = {
            labels: [@Html.Raw(xvaluevisit)],
            series: [
                { className: 'series-all', data: [@Html.Raw(yvaluevisit)] },
                { className: 'series-new', data: [@Html.Raw(ynewvaluevisit)] },
                { className: 'series-return', data: [@Html.Raw(yreturnvaluevisit)] }
            ]
        };

        var options = {
            seriesBarDistance: 10,
            axisX: { showGrid: false },
            height: "245px",
            axisY: { onlyInteger: true }
        };

        Chartist.Line('#chartVisit', dataVisits, options);

        var dataPreferences = {
            labels: [@Html.Raw(browserlabel)],
            series: [[@Html.Raw(browserpoint)]]
        };

        var optionsPreferences = {
            axisX: {
                labelInterpolationFnc: function (value) { return value; }
            }
        };

        new Chartist.Bar('#chartPreferences', dataPreferences, optionsPreferences);
    </script>
}
@page
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "WebStats: understand how people find and use your website";
    var d = Model.Data;
    var maxHour = Math.Max(1, d.Hourly.Max());
    string Pct(int value, int max) => (value * 100.0 / Math.Max(1, max)).ToString("0.#", CultureInfo.InvariantCulture);
}
@section Head {
    <meta name="description" content="WebStats shows which pages people read, where they come from and where they lose interest, so you know what to improve. One line of code, built in India by Rudra Softtech." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        .lp {
            --ink: #1d2340;
            --muted: #5b6275;
            --line: #e3e6ee;
            --surface: #f5f6fa;
            --accent: #e74c3c;
            --live: #16a34a;
            font-family: "Instrument Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
            color: var(--ink);
            max-width: 72rem;
            margin: 0 auto;
            padding: 0 1.25rem 4rem;
        }
        .lp h1, .lp h2, .lp h3 { font-family: inherit; color: var(--ink); }
        .lp a { color: var(--ink); text-underline-offset: .2em; }
        .lp a:hover { color: var(--accent); }
        .lp a:focus-visible, .lp button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: .25rem; }

        /* Hero */
        .lp-hero { display: grid; gap: 2.5rem; align-items: center; padding: 3.5rem 0 4rem; }
        @@media (min-width: 992px) { .lp-hero { grid-template-columns: 1.1fr .9fr; gap: 4rem; padding: 5rem 0; } }
        .lp-hero h1 { font-size: clamp(2.1rem, 4.6vw, 3.5rem); font-weight: 600; line-height: 1.06; letter-spacing: -.025em; max-width: 15ch; margin: 0 0 1.25rem; }
        .lp-lede { font-size: 1.15rem; line-height: 1.6; color: var(--muted); max-width: 34rem; margin: 0 0 2rem; }
        .lp-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
        /* .lp a.lp-btn outranks the general ".lp a" link colours */
        .lp a.lp-btn { display: inline-block; padding: .8rem 1.3rem; border-radius: .5rem; font-weight: 600; text-decoration: none; border: 2px solid var(--ink); color: var(--ink); background: transparent; }
        .lp a.lp-btn:hover { color: var(--ink); background: var(--surface); }
        .lp a.lp-btn-primary { background: var(--ink); color: #fff; }
        .lp a.lp-btn-primary:hover { background: #2b3360; border-color: #2b3360; color: #fff; }

        /* Live panel: the page's one bold element */
        .lp-pulse { margin: 0; padding: 1.75rem; border: 1px solid var(--line); border-radius: 1rem; background: #fff; }
        .lp-pulse figcaption { display: flex; align-items: center; gap: .5rem; font-weight: 500; color: var(--muted); }
        .lp-live-dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--live); box-shadow: 0 0 0 0 rgba(22, 163, 74, .5); animation: lp-ping 2s infinite; }
        @@keyframes lp-ping { 70% { box-shadow: 0 0 0 .5rem rgba(22, 163, 74, 0); } 100% { box-shadow: 0 0 0 0 rgba(22, 163, 74, 0); } }
        .lp-pulse-number { font-size: clamp(3rem, 7vw, 4.75rem); font-weight: 700; letter-spacing: -.03em; line-height: 1; margin: .5rem 0 1.5rem; font-variant-numeric: tabular-nums; }
        .lp-bars { display: flex; align-items: flex-end; gap: 3px; height: 9rem; }
        .lp-bars span { flex: 1; height: var(--h); min-height: 2px; background: var(--accent); opacity: .55; border-radius: 2px 2px 0 0; transform-origin: bottom; animation: lp-grow .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * 18ms); }
        .lp-bars span:last-child { opacity: 1; }
        .lp-bars span:hover { opacity: 1; }
        @@keyframes lp-grow { from { transform: scaleY(0); } }
        .lp-bars-axis { display: flex; justify-content: space-between; font-size: .8rem; color: var(--muted); margin-top: .5rem; }
        .lp-pulse-foot { margin: 1.25rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .95rem; }
        @@media (prefers-reduced-motion: reduce) { .lp-bars span, .lp-live-dot { animation: none; } }

        /* Sections */
        .lp-section { padding: 3.5rem 0; border-top: 1px solid var(--line); }
        .lp-section > h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 600; letter-spacing: -.015em; margin: 0 0 .5rem; }
        .lp-section > .lp-intro { color: var(--muted); font-size: 1.05rem; max-width: 40rem; margin: 0 0 2.25rem; }

        /* Features */
        .lp-features { display: grid; gap: 2rem 3rem; }
        @@media (min-width: 768px) { .lp-features { grid-template-columns: 1fr 1fr; } }
        .lp-feature h3 { font-size: 1.2rem; font-weight: 600; margin: 0 0 .4rem; }
        .lp-feature p { color: var(--muted); line-height: 1.6; margin: 0 0 .6rem; max-width: 32rem; }
        .lp-feature a { font-weight: 600; }
        .lp-feature code { background: var(--surface); padding: .15rem .35rem; border-radius: .25rem; font-size: .85em; color: var(--ink); }

        /* Steps (a real sequence, so numbered) */
        .lp-steps { list-style: none; counter-reset: step; padding: 0; margin: 0; display: grid; gap: 2rem; }
        @@media (min-width: 992px) { .lp-steps { grid-template-columns: repeat(3, 1fr); } }
        .lp-steps li { counter-increment: step; }
        .lp-steps li::before { content: counter(step); display: block; font-size: 2.75rem; font-weight: 700; line-height: 1; color: var(--accent); margin-bottom: .75rem; }
        .lp-steps h3 { font-size: 1.15rem; font-weight: 600; margin: 0 0 .4rem; }
        .lp-steps p { color: var(--muted); line-height: 1.6; margin: 0; }
        .lp-snippet { position: relative; margin-top: .75rem; }
        .lp-snippet pre { background: var(--ink); color: #e8eaf3; padding: .9rem 1rem; border-radius: .5rem; font-size: .8rem; white-space: pre-wrap; word-break: break-all; margin: 0; }
        .lp-copy { margin-top: .5rem; background: none; border: 1px solid var(--line); border-radius: .375rem; padding: .3rem .7rem; font: inherit; font-size: .85rem; color: var(--ink); cursor: pointer; }

        /* Sites */
        .lp-sites { list-style: none; padding: 0; margin: 0; columns: 1; column-gap: 3rem; }
        @@media (min-width: 576px) { .lp-sites { columns: 2; } }
        @@media (min-width: 992px) { .lp-sites { columns: 3; } }
        .lp-sites li { break-inside: avoid; padding: .7rem 0; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
        .lp-site-main { min-width: 0; }
        .lp-site-name { display: block; font-weight: 600; text-decoration: none; word-break: break-all; }
        .lp-site-name:hover { text-decoration: underline; }
        .lp-site-links { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: .2rem; font-size: .85rem; }
        .lp-site-links a { color: var(--muted); }
        .lp-site-links a:hover { color: var(--accent); }
        .lp-site-meta { color: var(--muted); font-size: .85rem; white-space: nowrap; display: flex; align-items: center; gap: .4rem; }
        .lp-site-meta .on { width: .45rem; height: .45rem; border-radius: 50%; background: var(--live); }
        .lp-closing { margin-top: 2.5rem; color: var(--muted); }

        /* Featured websites */
        .lp-featured { display: grid; gap: 1.5rem; margin-bottom: 3rem; }
        @@media (min-width: 992px) { .lp-featured { grid-template-columns: repeat(3, 1fr); } }
        .lp-site-card { border: 1px solid var(--line); border-radius: 1rem; padding: 1.5rem; background: #fff; display: flex; flex-direction: column; }
        .lp-site-card h3 { font-size: 1.15rem; font-weight: 600; margin: 0; word-break: break-all; }
        .lp-site-card h3 a { text-decoration: none; }
        .lp-site-card h3 a:hover { text-decoration: underline; }
        .lp-site-since { color: var(--muted); font-size: .85rem; margin: .2rem 0 1.25rem; display: flex; align-items: center; gap: .4rem; }
        .lp-site-since .on { width: .45rem; height: .45rem; border-radius: 50%; background: var(--live); }
        .lp-site-number { font-size: 2.4rem; font-weight: 700; letter-spacing: -.02em; line-height: 1; font-variant-numeric: tabular-nums; }
        .lp-site-label { color: var(--muted); font-size: .9rem; margin-top: .3rem; }
        .lp-mini-bars { display: flex; align-items: flex-end; gap: 2px; height: 3.5rem; margin: 1.25rem 0 .4rem; }
        .lp-mini-bars span { flex: 1; height: var(--h); min-height: 2px; background: var(--accent); opacity: .5; border-radius: 1px 1px 0 0; }
        .lp-mini-bars span:last-child { opacity: 1; }
        .lp-mini-axis { display: flex; justify-content: space-between; font-size: .75rem; color: var(--muted); }
        .lp-site-total { margin: 1rem 0 1.25rem; padding-top: .9rem; border-top: 1px solid var(--line); font-size: .9rem; color: var(--muted); }
        .lp-site-total strong { color: var(--ink); font-weight: 600; }
        .lp-site-actions { margin-top: auto; display: flex; flex-wrap: wrap; gap: 1rem; font-size: .9rem; font-weight: 600; }
        .lp-others-title { font-size: 1.15rem; font-weight: 600; margin: 0 0 1rem; }
        .lp-privacy { margin: 2.5rem 0 0; padding: 1rem 1.25rem; background: var(--surface); border-radius: .75rem; color: var(--muted); max-width: 46rem; }
    </style>
}

<div class="lp">

    <section class="lp-hero">
        <div>
            <h1>Understand how people find and use your website.</h1>
            <p class="lp-lede">
                WebStats shows which pages people read, where they come from and where they lose interest,
                so you know what to improve. Add one line of code and your first report is ready in minutes.
            </p>
            <div class="lp-actions">
                @if (d.SiteCount > 0)
                {
                    <a class="lp-btn lp-btn-primary" href="#websites">See live reports</a>
                }
                <a class="lp-btn" href="@IndexModel.ContactUrl" rel="noopener">Add your website</a>
            </div>
        </div>

        <figure class="lp-pulse">
            <figcaption><span class="lp-live-dot" aria-hidden="true"></span>Visits in the last 24 hours</figcaption>
            <div class="lp-pulse-number">@d.VisitsLast24h.ToString("N0")</div>
            <div class="lp-bars" role="img" aria-label="Visits per hour over the last 24 hours, up to @maxHour in one hour">
                @for (var i = 0; i < 24; i++)
                {
                    <span style="--h:@Pct(d.Hourly[i], maxHour)%; --i:@i" title="@(d.HourLabels[i]): @d.Hourly[i] visits"></span>
                }
            </div>
            <div class="lp-bars-axis" aria-hidden="true"><span>24 hours ago</span><span>Now</span></div>
            <p class="lp-pulse-foot">
                Across @d.SiteCount websites using WebStats.
                @d.TotalVisits.ToString("N0") visits counted since @d.FirstYear, not including bots.
            </p>
        </figure>
    </section>

    <section class="lp-section" aria-labelledby="features-title">
        <h2 id="features-title">What your report shows</h2>
        <p class="lp-intro">Open any of the websites below to explore a real report with live numbers.</p>

        <div class="lp-features">
            <article class="lp-feature">
                <h3>Where your visitors come from</h3>
                <p>Google search, ads, Instagram and Facebook, WhatsApp shares and other websites, along with the cities and devices people use.</p>
            </article>
            <article class="lp-feature">
                <h3>How a visit unfolds</h3>
                <p>Follow a visit from page to page: what was read, for how long, and which links and buttons were used along the way.</p>
            </article>
            <article class="lp-feature">
                <h3>How each page performs</h3>
                <p>See where people click, how far down they read and where they move on, including taps on things that aren't links, so you know what to fix.</p>
            </article>
            <article class="lp-feature">
                <h3>View counts on your own pages</h3>
                <p>Show "1,234 views" under each blog post or product by adding <code>&lt;span data-webstats="views"&gt;&lt;/span&gt;</code> where the number should appear.</p>
            </article>
        </div>

        <p class="lp-privacy">Reports show numbers and patterns, never names, email addresses or IP addresses. Visits from bots and search engine crawlers are left out automatically.</p>
    </section>

    @if (d.SiteCount > 0)
    {
        <section class="lp-section" id="websites" aria-labelledby="sites-title">
            <h2 id="sites-title">Websites using WebStats</h2>
            <p class="lp-intro">The busiest websites this month. Open a report to see their real numbers.</p>

            <div class="lp-featured">
                @foreach (var s in d.Featured)
                {
                    var maxDay = s.Daily.Length == 0 ? 1 : Math.Max(1, s.Daily.Max());
                    <article class="lp-site-card">
                        <h3><a href="@Url.Page("/Report", new { id = s.Id })">@s.Host</a></h3>
                        <div class="lp-site-since">
                            @if (s.ActiveThisWeek)
                            {
                                <span class="on" title="Visits this week" aria-hidden="true"></span>
                            }
                            Using WebStats since @s.SinceYear
                        </div>

                        <div class="lp-site-number">@s.VisitsLast30Days.ToString("N0")</div>
                        <div class="lp-site-label">visits in the last 30 days</div>

                        <div class="lp-mini-bars" role="img" aria-label="Visits per day over the last 30 days for @s.Host">
                            @for (var i = 0; i < s.Daily.Length; i++)
                            {
                                <span style="--h:@Pct(s.Daily[i], maxDay)%" title="@s.Daily[i] visits"></span>
                            }
                        </div>
                        <div class="lp-mini-axis" aria-hidden="true"><span>30 days ago</span><span>Today</span></div>

                        <p class="lp-site-total"><strong>@s.TotalVisits.ToString("N0")</strong> visits since @s.SinceYear</p>

                        <div class="lp-site-actions">
                            <a href="@Url.Page("/Report", new { id = s.Id })">Open report</a>
                            <a href="@Url.Page("/Visits", new { id = s.Id })">Browse visits</a>
                            <a href="https://@s.Host" target="_blank" rel="noopener nofollow">Visit website</a>
                        </div>
                    </article>
                }
            </div>

            @if (d.Others.Count > 0)
            {
                <h3 class="lp-others-title">Also using WebStats</h3>
                <ul class="lp-sites">
                    @foreach (var s in d.Others)
                    {
                        <li>
                            <div class="lp-site-main">
                                <a class="lp-site-name" href="@Url.Page("/Report", new { id = s.Id })">@s.Host</a>
                                <span class="lp-site-links">
                                    <a href="@Url.Page("/Report", new { id = s.Id })">Report</a>
                                    <a href="@Url.Page("/Visits", new { id = s.Id })">Visits</a>
                                    <a href="https://@s.Host" target="_blank" rel="noopener nofollow">Website</a>
                                </span>
                            </div>
                            <span class="lp-site-meta" title="Visits in the last 30 days">
                                @if (s.ActiveThisWeek)
                                {
                                    <span class="on" aria-hidden="true"></span>
                                }
                                @s.VisitsLast30Days.ToString("N0") this month
                            </span>
                        </li>
                    }
                </ul>
            }

            <p class="lp-closing">Want your website here? <a href="@IndexModel.ContactUrl" rel="noopener">Get in touch</a>.</p>
        </section>
    }

    <section class="lp-section" aria-labelledby="start-title">
        <h2 id="start-title">Get started</h2>
        <p class="lp-intro">It works with any website: WordPress, Shopify, ASP.NET, PHP or plain HTML.</p>

        <ol class="lp-steps">
            <li>
                <h3>Tell us your website</h3>
                <p>Send us your website address and we'll set up your report. Self-service sign-up is coming soon.</p>
                <p class="mt-2"><a href="@IndexModel.ContactUrl" rel="noopener">Contact Rudra Softtech</a></p>
            </li>
            <li>
                <h3>Add one line of code</h3>
                @if (string.IsNullOrWhiteSpace(IndexModel.InstallSnippet))
                {
                    <p>We send you a single script tag. Paste it into your website's template, just before the closing <code>&lt;/body&gt;</code> tag.</p>
                }
                else
                {
                    <p>Paste this into your website's template, just before the closing <code>&lt;/body&gt;</code> tag. We'll give you your website's ID.</p>
                    <div class="lp-snippet">
                        <pre id="lpSnippet">@IndexModel.InstallSnippet.Replace("{id}", "YOUR-ID")</pre>
                        <button type="button" class="lp-copy" id="lpCopy">Copy code</button>
                    </div>
                }
            </li>
            <li>
                <h3>See your first report</h3>
                <p>Open your report and watch the numbers come in. Visits from bots are left out automatically.</p>
            </li>
        </ol>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var button = document.getElementById('lpCopy');
            var snippet = document.getElementById('lpSnippet');
            if (!button || !snippet || !navigator.clipboard) return;
            button.addEventListener('click', function () {
                navigator.clipboard.writeText(snippet.textContent).then(function () {
                    button.textContent = 'Copied';
                    setTimeout(function () { button.textContent = 'Copy code'; }, 2000);
                });
            });
        })();
    </script>
}
